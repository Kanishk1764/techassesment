{
  "name": "ai-resume-screener",
  "version": "1.0.0",
  "private": true,
  "description": "AI Resume Screener & Evaluation Platform (Python FastAPI + Next.js)",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python backend/main.py",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "pytest backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
